# Secrets — must never be committed
.env
.env.*
.env.local
*.local
INFRA.md
INFRA.zh-CN.md
sealed-secrets-key.pem
*.pem
*.key
secrets-backup/
# Data dumps. reset.sh's banner and runbook §0 tell you to write these to
# ~/outpost-carry/ (outside the repo), but a stray run inside the checkout
# must not be committable: a pg_dumpall is business data and a RabbitMQ
# definitions export contains user password hashes.
pg-*.sql
rabbitmq-definitions-*.json

# Local state
volumes/
.kubeconfig
kubeconfig
# verify.sh reconciliation state (warm manifest checkout + mismatch timestamps)
.outpost-state/

# Per-installation onboarded apps — content is generated by `outpost onboard`
# from each app's outpost.app.yaml; never commit the rendered fragments
# / compose overrides into the infras repo (the whole point of v0.5).
# Caddyfile.d/.gitkeep + Caddyfile.d/README.md are tracked exceptions.
core/compose/Caddyfile.d/*.caddy
core/compose/overrides/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
# Visual Studio / Rider auto-generated solution scaffold (we are not a .NET project)
*.sln
*.suo
*.user
.vs/

# Claude Code local workspace — PRP artifacts are tracked under docs/prp/
.claude/

# Logs
*.log
infra-autostart.log

# Test artifacts
tests/.coverage
tests/output/
.bats-tmp/
