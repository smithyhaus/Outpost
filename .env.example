# =============================================================================
# Outpost — environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in. `bootstrap.sh` will auto-generate any blank
# password fields. The `.env` file is gitignored — never commit it.
# =============================================================================

# ---- Mode ----
# local : Compose data services only (PG / Redis / RabbitMQ / Manticore on
#         localhost). No Cloudflare Tunnel, no k3s, no GitOps. Zero required
#         input — `bash bootstrap.sh` runs end-to-end with all defaults.
# full  : Everything above + Cloudflare Tunnel + k3s + GitHub Actions
#         self-hosted runner + manifest-sync CronJob CI/CD.
#         Requires ROOT_DOMAIN, CF_TUNNEL_TOKEN, GIT_USER, GIT_TOKEN,
#         MANIFEST_REPO_URL, OUTPOST_REPOS.
OUTPOST_MODE=local

# ---- Domain ----
# Required for `full` mode. Ignored in `local` mode (defaults to outpost.local).
ROOT_DOMAIN=

# ---- Optional: subdomain prefix overrides ----
# Built-in services advertise these subdomains under ROOT_DOMAIN. The defaults
# match the documented URLs in INFRA.md / Cloudflare Tunnel setup. Override
# only if the default prefix collides with an existing record in your zone.
# Naming convention: *_HOST = subdomain prefix (joined with .${ROOT_DOMAIN});
# REGISTRY_HOST is the exception — see notes below.
# SEARCH_HOST=search          # → search.<ROOT_DOMAIN>     (Manticore HTTP UI)
# MQ_HOST=mq                  # → mq.<ROOT_DOMAIN>         (RabbitMQ mgmt UI)
# REGISTRY_SUBDOMAIN=registry # → <prefix>.<ROOT_DOMAIN>   (only used when
#                             #   REGISTRY_PLUGIN=self-hosted; the aliyun-acr
#                             #   plugin sets REGISTRY_HOST to its own offsite
#                             #   value and ignores this prefix)
# (v0.3 移除: ARGOCD_HOST/HOOKS_HOST — ArgoCD 与 webhook 接收端已退役;
#  SEARCH_UPSTREAM/MQ_UPSTREAM — mq/search 由集群内 Traefik IngressRoute
#  固定指向 infra-bridges 服务, 不再经 caddy 代理可覆盖端点)

# ---- Cloudflare Tunnel ----
# Required for `full` mode only. Get from Cloudflare Dashboard → Zero Trust →
# Networks → Tunnels → Create.
CF_TUNNEL_TOKEN=

# Tunnel 传输协议。默认 auto（QUIC）；QUIC 的 UDP/7844 被网络策略/NAT 吞掉时
# 设为 http2（WSL2/受限网络的常见解法——症状是 tunnel 反复重连不稳定）。
# Transport protocol for cloudflared. Default auto (QUIC); set http2 when
# UDP/7844 is blocked (common on WSL2/restricted networks).
# CF_TUNNEL_PROTOCOL=http2

# ---- Platform plugins ----
# Registry plugin — see plugins/registry/<name>/ for available choices.
# Built-in: self-hosted (default), aliyun-acr
REGISTRY_PLUGIN=self-hosted

# How many recent sha-7 tags per app the self-hosted registry GC keeps (and
# the depth `outpost rollback` can reach without a manual re-build). Bumped
# from the pre-v0.3 default of 5 → 10 now that CI is a GitHub Actions runner
# (cheap to keep more, expensive to lose rollback depth on a red build).
# 中文: 每个 app 保留的镜像 tag 数量（GC 保留数 = 回滚可达深度）。
OUTPOST_REGISTRY_KEEP_TAGS=10

# Git provider plugin — credential + host-matching contract, no longer a
# webhook receiver (v0.3 retires the inbound-webhook path entirely; CI is
# triggered by GitHub Actions on a self-hosted runner, see GITHUB_RUNNER_*
# below). Built-in: gitee (default), github, gitlab.
# Accepts a COMMA-SEPARATED LIST — each enabled provider's preflight.sh runs
# an authenticated `git ls-remote` against every OUTPOST_REPOS entry whose
# host it owns, so a revoked/expired token fails LOUDLY at bootstrap instead
# of silently breaking builds/reconciliation later:
#   GIT_PROVIDER_PLUGIN=gitee,github,gitlab
# To clone PRIVATE app repos on a DIFFERENT host than MANIFEST_REPO_URL, add
# per-host credentials via GIT_CREDENTIALS_EXTRA below.
# 中文: git 平台插件——不再是 webhook 接收方，只做凭据校验 + host 归属判定。
GIT_PROVIDER_PLUGIN=gitee

# ---- OUTPOST_REPOS — app repo registry (replaces WEBHOOK_REPO_WHITELIST) ----
# Comma-separated list of "<canonical-clone-url>[#<branch>]" entries — one per
# app repo Outpost builds/deploys. Branch is OPTIONAL; omitted branch means
# OUTPOST_DEPLOY_BRANCH (below) applies at consume-time. Either gitee or
# github clone URLs are valid (whichever is the canonical/primary one for
# that repo — gitee is the recommended primary per plugins/git-provider/gitee
# README, github only needs a mirror for the workflow to trigger from).
#   OUTPOST_REPOS=https://gitee.com/org/svc-a.git,https://gitee.com/org/svc-b.git#release
# This list is now the SINGLE source of truth for:
#   - git-provider preflight.sh (per-host authenticated ls-remote probe)
#   - verify.sh reconciliation (live HEAD vs deployed manifest tag per repo —
#     the "ultimate judge" anti-silence layer; a repo missing from here is
#     invisible to reconciliation, so add it as soon as you onboard the app)
#   - `outpost onboard` (appends here automatically; `outpost off-board`
#     removes the matching entry)
# It fully replaces the old WEBHOOK_REPO_WHITELIST — that var gated an
# inbound webhook CEL filter that no longer exists; this one is the positive
# registry the reconciliation loop walks. Empty = nothing to reconcile
# (verify.sh has nothing to check, which is itself worth noticing on a
# "full" install).
# 中文: 应用仓库注册表——git-provider 探活 + verify.sh 对账 + onboard/off-board
# 都以此为唯一事实源，替代原来的 webhook 白名单。
OUTPOST_REPOS=

# ---- GitHub Actions self-hosted runner (CI trigger surface) ----
# GitHub Actions (self-hosted runner on this host) is the CI engine; gitee
# stays the primary push target + manifest-repo host + reconciliation basis
# (see docs/prp/plans/outpost-cicd-dispatcher-engine.plan.md §2-3). App repos
# need a github.com copy (dual-push from gitee, or gitee's official one-way
# push-mirror — see plugins/git-provider/gitee/README.md) so GitHub can fire
# the workflow that drives this runner.
#
# GITHUB_RUNNER_URL — org-level is recommended (one runner registration
# shared by every private repo in the org): https://github.com/<org>
# A single-repo URL (https://github.com/<owner>/<repo>) also works but the
# runner then only serves that one repo.
GITHUB_RUNNER_URL=
# GITHUB_RUNNER_PAT — used ONLY to mint short-lived runner *registration*
# tokens via the GitHub API (never stored as the runner's long-lived auth).
# EMPTY = runner install/checks are SKIPPED with a loud WARN — this is the
# supported CI/e2e mode for running this repo's own test suite without a
# real GitHub org to register against. Never echoed; preflight masks it in
# any log output.
# 中文: 仅用于换取 runner 注册令牌；留空则跳过 runner 安装/校验并打印醒目 WARN
# （CI/e2e 场景下的合法状态，不是配置错误）。
GITHUB_RUNNER_PAT=
GITHUB_RUNNER_LABELS=outpost
# GITHUB_RUNNER_NAME — defaults to outpost-<hostname> when blank.
GITHUB_RUNNER_NAME=

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# ---- Redis ----
REDIS_PASSWORD=

# ---- RabbitMQ ----
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# ---- Manticore Search ----
# Standalone mode has no built-in auth, so no key needed. The replication
# hook lives at core/compose/manticore/conf.d/ (see that dir's README.md).

# ---- Git provider credentials (full mode only) ----
# Used to pull the manifest repo (manifest-sync CronJob) and, when a matching
# OUTPOST_REPOS host needs it, to clone app repos. GIT_USER/GIT_TOKEN/GIT_HOST
# cover the MANIFEST_REPO_URL host (the primary). For private app repos on
# OTHER hosts, see GIT_CREDENTIALS_EXTRA below.
GIT_USER=
GIT_TOKEN=

# Optional: extra clone credentials for PRIVATE app repos hosted on a DIFFERENT
# host than MANIFEST_REPO_URL. Needed when GIT_PROVIDER_PLUGIN spans providers
# (e.g. manifest repo on gitee, but you also build private github / self-hosted
# gitlab repos). Format: comma-separated `host|user|token` entries —
#   GIT_CREDENTIALS_EXTRA=gitlab.mycorp.com|ci-bot|glpat-xxxx,github.com|bot|ghp_yyyy
# Consumed by each git-provider plugin's preflight.sh (authenticated ls-remote
# probe per OUTPOST_REPOS host). Empty (default) = single-host (the
# MANIFEST_REPO host only). Public repos need no entry. host = bare hostname
# (no https://).
GIT_CREDENTIALS_EXTRA=

# ---- Manifest repository (deploy source-of-truth, full mode only) ----
# HTTPS URL ending in .git. Pulled every MANIFEST_SYNC_INTERVAL minutes by the
# in-cluster manifest-sync CronJob (ns outpost-ci) — gitee, domestic path.
MANIFEST_REPO_URL=
MANIFEST_REPO_BRANCH=main

# Minutes between manifest-sync CronJob runs (git pull manifest repo → kubectl
# apply -k changed apps → rollout wait). concurrencyPolicy=Forbid, so a slow
# rollout just pushes the next tick rather than overlapping.
# 中文: manifest-sync CronJob 的执行间隔（分钟）。
MANIFEST_SYNC_INTERVAL=2

# Seconds an OUTPOST_REPOS entry may sit with live HEAD != deployed manifest
# tag before verify.sh's reconciliation check reports FAIL. This is the
# "ultimate judge" anti-silence layer — it catches a dead mirror, a red
# workflow, an offline runner, or a stalled sync job from OUTSIDE the chain
# that could be failing. Default 1800s (30min) tolerates one missed
# manifest-sync tick plus normal build time without false-alarming.
# 中文: 对账允许的最大滞后秒数，超过即 FAIL 并点名具体仓库。
OUTPOST_STALENESS_THRESHOLD=1800

# ---- Deploy branch (CI/CD trigger) ----
# Branch of YOUR APP repo whose pushes trigger the GitHub Actions workflow.
# Pushes to any other branch are ignored (workflow's `on: push: branches:`).
# Default: main. Set to `master` (or your convention) for repos that don't
# use main. Distinct from MANIFEST_REPO_BRANCH above (the manifests repo the
# sync job watches).
OUTPOST_DEPLOY_BRANCH=main

# Auto-derived by bootstrap.sh from MANIFEST_REPO_URL (e.g. gitee.com /
# github.com / gitlab.com). Used for the primary GIT_USER/GIT_TOKEN pairing.
# Leave blank — bootstrap will populate it on first run.
GIT_HOST=

# ---- Aliyun ACR (only if REGISTRY_PLUGIN=aliyun-acr) ----
ALIYUN_ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ALIYUN_ACR_NAMESPACE=
ALIYUN_ACR_USER=
ALIYUN_ACR_PASSWORD=

# =============================================================================
# CI/CD test gate + auto-rollback + notifications (full mode only)
# Proposal: i18n/{en,zh-CN}/docs/proposals/cicd-test-gate.md
# =============================================================================

# ---- Test runner plugin ----
# Built-in: testkube (default — K8s-native, 30+ engines)
TEST_RUNNER=testkube
TESTKUBE_MODE=skip           # skip (default) | oss | cloud
TESTKUBE_CLOUD_API_KEY=      # only if TESTKUBE_MODE=cloud (Phase 2)

# ---- CI build knobs (scripts/ci/*, optional) ----
# publish 型仓库清单（构建时发 npm 包到 Verdaccio 而非出镜像）。逗号分隔的
# 仓库名；默认 fst-foundation。
# Comma list of repos that PUBLISH (@hy/* → Verdaccio) instead of building
# an image. Default: fst-foundation.
# OUTPOST_LIBRARY_REPOS=fst-foundation
# Verdaccio 发布地址覆盖（默认走集群内地址；publish-npm.sh 消费）。
# Override for the Verdaccio publish endpoint (consumed by publish-npm.sh).
# HY_REGISTRY_PUBLISH_URL=
# Gate A 默认测试容器镜像（run-tests.sh；应用可用 outpost.test.yaml 覆盖）。
# Default Gate A container image (apps override via outpost.test.yaml).
# OUTPOST_TEST_IMAGE=alpine:3.20

# ---- Rollout plugin ----
# Built-in: argo-rollouts (controller-only; opt-in canary + auto-rollback via
# the Rollout CRD — the manifest-sync CronJob is Rollout-kind aware and waits
# on its status the same way it waits on Deployment rollouts).
# Default `none` (v0.3) — ArgoCD/Tekton-era dashboard + AnalysisTemplate
# wiring is gone; apps that want canary opt in per-app by adopting the
# Rollout CRD in their manifests. Set to `argo-rollouts` to install the
# controller.
# 中文: 默认关闭；设为 argo-rollouts 仅安装控制器，应用按需自行采用 Rollout CRD。
ROLLOUT_PLUGIN=none

# ---- Notification plugins ----
# Comma-separated list of enabled providers.
# Built-in: dingtalk, feishu, wecom, webhook-generic
# Empty disables CI/CD notifications entirely. Events: build-failed (GitHub
# Actions workflow), deploy-succeeded/deploy-failed (manifest-sync CronJob),
# verify-failed (host systemd timer running verify.sh --quiet every 30min).
NOTIFICATION_PROVIDERS=

# DingTalk group robot
DINGTALK_WEBHOOK_URL=
DINGTALK_SIGN_SECRET=        # optional but recommended (HMAC-signed webhook)

# Feishu (Lark) custom bot
FEISHU_WEBHOOK_URL=
FEISHU_SIGN_SECRET=          # optional

# WeCom (企业微信) group robot
WECOM_WEBHOOK_URL=

# Generic webhook (POSTs raw normalized payload — for self-hosted relays)
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_BEARER=      # optional Bearer token
